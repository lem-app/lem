# Production Environment Configuration
# Copy this file to .env.production and update with your production URLs.
#
# All three URLs below are REQUIRED for a production build: src/lib/env.ts
# refuses to start without them rather than falling back to localhost, and it
# rejects ws://  or http:// when the dashboard itself is served over HTTPS
# (the browser would block those as mixed content).

# Signaling server URL (WebSocket, secure)
VITE_SIGNAL_URL=wss://signal.lem.gg/signal

# API base URL (HTTPS, secure)
VITE_API_BASE_URL=https://signal.lem.gg

# Relay server URL (WebSocket, secure)
VITE_RELAY_URL=wss://relay.lem.gg

# Optional: local Lem server as addressed from the far side of the tunnel.
# VITE_LOCAL_API_URL=http://localhost:5142

# Optional: STUN/TURN servers, comma-separated. None by default.
# VITE_ICE_SERVERS=stun:stun.example.org:3478,turns:turn.example.org:5349
