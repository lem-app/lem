# Signaling server URL (WebSocket)
VITE_SIGNAL_URL=ws://localhost:8000/signal

# API base URL (HTTP)
VITE_API_BASE_URL=http://localhost:8000

# Relay server URL (WebSocket)
VITE_RELAY_URL=ws://localhost:8001

# Local Lem server, as addressed from the far side of the tunnel.
# Optional; defaults to http://localhost:5142.
# VITE_LOCAL_API_URL=http://localhost:5142

# STUN/TURN servers, comma-separated. Opt-in: Lem ships with none so it never
# discloses a user's IP address to a third party without being asked.
# VITE_ICE_SERVERS=stun:stun.example.org:3478,turns:turn.example.org:5349
