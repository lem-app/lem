{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "vitest/globals"],
    "skipLibCheck": true,

    /* The Service Worker is authored as a checked ES module in `public/`: it
       must be served verbatim at the origin root for the `/app/` scope to be
       claimable, and a build step between source and served bytes is a place
       for the two to disagree. JSDoc types make it as strict as the .ts. */
    "allowJs": true,
    "checkJs": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting - Strict mode enabled */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // Tests are type-checked too. Excluding them let `webrtc.test.ts` push a
  // `string | ArrayBuffer` into a `string[]` without anyone noticing.
  "include": ["src", "public/lem-app-sw.js"]
}
