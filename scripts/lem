#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (c) 2025 Lem
#
# Lem CLI wrapper
#
# Usage:
#   lem start   - Start the server
#   lem stop    - Stop the server
#   lem status  - Check server status
#   lem logs    - View logs

set -e

LEM_HOME="${LEM_HOME:-$HOME/.lem}"
LEM_PORT="${LEM_PORT:-5142}"
LOG_FILE="$LEM_HOME/logs/lem.log"

# Find server directory (could be symlink or actual directory)
if [ -L "$LEM_HOME/server" ]; then
    SERVER_DIR="$(readlink -f "$LEM_HOME/server")"
else
    SERVER_DIR="$LEM_HOME/server"
fi

# Detect platform
OS="$(uname -s)"
case "$OS" in
    Darwin) PLATFORM="macos" ;;
    Linux) PLATFORM="linux" ;;
    *) PLATFORM="unknown" ;;
esac

cmd_start() {
    echo "Starting Lem server..."

    # Check if already running
    if curl -s "http://localhost:$LEM_PORT/v1/health" &> /dev/null; then
        echo "Server is already running on port $LEM_PORT"
        return 0
    fi

    case "$PLATFORM" in
        macos)
            if [ -f "$HOME/Library/LaunchAgents/gg.lem.server.plist" ]; then
                launchctl load "$HOME/Library/LaunchAgents/gg.lem.server.plist" 2>/dev/null || true
                launchctl start gg.lem.server 2>/dev/null || true
            else
                (cd "$SERVER_DIR" && nohup uv run uvicorn app.main:app --host 0.0.0.0 --port "$LEM_PORT" > "$LOG_FILE" 2>&1 &)
            fi
            ;;
        linux)
            if systemctl is-enabled lem.service &> /dev/null; then
                sudo systemctl start lem.service
            else
                (cd "$SERVER_DIR" && nohup uv run uvicorn app.main:app --host 0.0.0.0 --port "$LEM_PORT" > "$LOG_FILE" 2>&1 &)
            fi
            ;;
        *)
            (cd "$SERVER_DIR" && nohup uv run uvicorn app.main:app --host 0.0.0.0 --port "$LEM_PORT" > "$LOG_FILE" 2>&1 &)
            ;;
    esac

    # Wait for startup
    echo -n "Waiting for server..."
    for i in {1..30}; do
        if curl -s "http://localhost:$LEM_PORT/v1/health" &> /dev/null; then
            echo " started!"
            echo "Dashboard: http://localhost:$LEM_PORT"
            return 0
        fi
        echo -n "."
        sleep 1
    done

    echo " timeout"
    echo "Check logs: $LOG_FILE"
    return 1
}

cmd_stop() {
    echo "Stopping Lem server..."

    case "$PLATFORM" in
        macos)
            if [ -f "$HOME/Library/LaunchAgents/gg.lem.server.plist" ]; then
                launchctl stop gg.lem.server 2>/dev/null || true
                launchctl unload "$HOME/Library/LaunchAgents/gg.lem.server.plist" 2>/dev/null || true
            fi
            ;;
        linux)
            if systemctl is-enabled lem.service &> /dev/null; then
                sudo systemctl stop lem.service
            fi
            ;;
    esac

    # Kill any remaining processes
    pkill -f "uvicorn app.main:app.*--port $LEM_PORT" 2>/dev/null || true

    echo "Server stopped"
}

cmd_status() {
    if curl -s "http://localhost:$LEM_PORT/v1/health" &> /dev/null; then
        echo "Lem server is running on port $LEM_PORT"
        echo ""
        curl -s "http://localhost:$LEM_PORT/v1/health" | python3 -m json.tool 2>/dev/null || \
            curl -s "http://localhost:$LEM_PORT/v1/health"
    else
        echo "Lem server is not running"
        return 1
    fi
}

cmd_logs() {
    if [ -f "$LOG_FILE" ]; then
        tail -f "$LOG_FILE"
    else
        echo "No log file found at $LOG_FILE"
        return 1
    fi
}

cmd_help() {
    echo "Lem CLI - Local AI launcher with remote access"
    echo ""
    echo "Usage: lem <command>"
    echo ""
    echo "Commands:"
    echo "  start   Start the Lem server"
    echo "  stop    Stop the Lem server"
    echo "  status  Check server status"
    echo "  logs    View server logs (tail -f)"
    echo "  help    Show this help"
    echo ""
    echo "Dashboard: http://localhost:$LEM_PORT"
    echo "API Docs:  http://localhost:$LEM_PORT/docs"
}

# Main
case "${1:-help}" in
    start)  cmd_start ;;
    stop)   cmd_stop ;;
    status) cmd_status ;;
    logs)   cmd_logs ;;
    help|--help|-h) cmd_help ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'lem help' for usage"
        exit 1
        ;;
esac
