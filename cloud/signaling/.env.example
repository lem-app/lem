# Signaling Server Configuration
# Copy this file to .env and fill in the required values.
#
# SECRET_KEY and CORS_ORIGINS have no defaults. The server refuses to start
# without them, on purpose: a shipped default secret key is a shipped
# authentication bypass, because HS256 is symmetric and this repository is
# public, so every reader could forge a token for any account.

# JWT Settings
# REQUIRED. Generate with: openssl rand -hex 32
# Must be identical on the signaling and relay servers: signaling mints the
# relay session grants that the relay verifies.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Lifetime of a relay session grant, in seconds. It only has to cover the
# round trip from connect-request to the relay WebSocket handshake.
RELAY_GRANT_TTL_SECONDS=120

# Lifetime of a device registration challenge, in seconds.
CHALLENGE_TTL_SECONDS=120

# Database
# Development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./signaling.db
# Production (PostgreSQL example)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/signaling

# Server
HOST=0.0.0.0
PORT=8000

# CORS - REQUIRED, comma-separated list of allowed origins.
# "*" is rejected: this API is credentialed, and a wildcard with credentials
# makes the server reflect whatever Origin the caller sends.
# Development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Production
# CORS_ORIGINS=https://lem.gg,https://app.lem.gg

# Rate Limiting (per client IP; logins are additionally limited per account)
MAX_CONNECTIONS_PER_SECOND=5
MAX_REGISTRATIONS_PER_HOUR=5
MAX_LOGINS_PER_MINUTE=10

# Set to true only when a trusted reverse proxy appends the real client
# address to X-Forwarded-For (the shipped nginx configs do). Enabling it
# without such a proxy lets any caller spoof its address and bypass the
# limits above.
TRUST_X_FORWARDED_FOR=false

# Relay Server URL
# Development
RELAY_URL=ws://localhost:8001
# Production
# RELAY_URL=wss://relay.lem.gg
