# Relay Server Configuration
# Copy this file to .env and fill in the required values.
#
# SECRET_KEY and CORS_ORIGINS have no defaults. The server refuses to start
# without them, on purpose: a shipped default secret key is a shipped
# authentication bypass, because HS256 is symmetric and this repository is
# public, so every reader could forge a session grant.

# JWT Settings
# REQUIRED. Must be byte-for-byte identical to the signaling server's key:
# signaling mints the relay session grants this server verifies.
# Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256

# Server
HOST=0.0.0.0
PORT=8001

# CORS - REQUIRED, comma-separated list of allowed origins.
# "*" is rejected: this API is credentialed, and a wildcard with credentials
# makes the server reflect whatever Origin the caller sends.
# Development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Production
# CORS_ORIGINS=https://lem.gg,https://app.lem.gg

# Close a paired session that has relayed nothing for this many seconds.
SESSION_TIMEOUT=300

# How long the first peer waits alone before the session is abandoned.
PAIR_TIMEOUT=30

# Bytes the first peer may buffer before its partner arrives.
MAX_PREPAIR_BUFFER_BYTES=262144

# Capacity limits. Sessions are in-process, so these bound one worker.
MAX_SESSIONS=1000
MAX_SESSIONS_PER_USER=10

# WebSocket settings
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10
